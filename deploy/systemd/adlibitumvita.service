[Unit]
Description=Ad Libitum Vita (Astro/Node)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/adlibitumvita/current
EnvironmentFile=/srv/adlibitumvita/shared/.env
Environment=HOST=127.0.0.1
# ALV-owned Node runtime — never the system Node other apps on this host use.
ExecStart=/srv/adlibitumvita/shared/runtime/current/bin/node ./dist/server/entry.mjs
Restart=on-failure
RestartSec=3
MemoryMax=512M

# Loopback only — nginx is the public edge.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/adlibitumvita/shared

StandardOutput=journal
StandardError=journal
SyslogIdentifier=adlibitumvita

[Install]
WantedBy=multi-user.target
