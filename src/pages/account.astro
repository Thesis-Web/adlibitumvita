---
import BaseLayout from "../layouts/BaseLayout.astro";

const user = Astro.locals.user;
---

<BaseLayout title="Account" noindex container="narrow">
  <p class="eyebrow">Your account</p>
  <h1>{user?.name}</h1>
  <div class="card">
    <p class="muted" style="margin-bottom: 0.25rem;">{user?.email}</p>
    <p class="muted">Role: {user?.role}</p>
    <a class="btn secondary" href="/logout">Log out</a>
  </div>
</BaseLayout>
