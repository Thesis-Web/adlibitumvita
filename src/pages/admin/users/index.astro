---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { listUsers } from "../../../lib/users.js";

const users = listUsers();
---

<BaseLayout title="Users" noindex container="wide">
  <p class="eyebrow"><a href="/admin">← Admin</a></p>
  <h1>Users</h1>

  <div class="table-wrap">
    <table class="users-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Library access</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {users.map((user) => (
          <tr data-user-id={user.id}>
            <td><strong>{user.name}</strong></td>
            <td class="muted">{user.email}</td>
            <td>{user.role}</td>
            <td>
              <span class={`badge ${user.hasLibraryAccess ? "published" : "draft"}`}>
                {user.hasLibraryAccess ? "active" : "none"}
              </span>
            </td>
            <td>
              <button type="button" class="btn secondary small grant-toggle">
                {user.hasLibraryAccess ? "Revoke" : "Grant"}
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="add-user-heading">Add a family user</h2>
  <form id="create-user-form" class="card" style="max-width: 26rem;">
    <div class="field">
      <label for="name">Name</label>
      <input id="name" name="name" required />
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required />
    </div>
    <div class="field">
      <label for="password">Temporary password</label>
      <input id="password" name="password" type="password" minlength="12" required />
    </div>
    <p id="create-error" class="form-error" style="display: none;"></p>
    <button class="btn coral" type="submit">Create user with library access</button>
  </form>

  <style>
    .users-table { margin-bottom: 2rem; }
    .add-user-heading { margin-top: 2.5rem; }
    .form-error { color: #b8442c; font-size: 0.88rem; }
  </style>

  <script>
    const table = document.querySelector("tbody") as HTMLElement;
    table.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement;
      if (!target.classList.contains("grant-toggle")) return;
      const row = target.closest("[data-user-id]") as HTMLElement;
      const userId = row.dataset.userId!;
      const isRevoking = target.textContent?.trim() === "Revoke";
      await fetch(`/api/admin/users/${userId}/grant`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ action: isRevoking ? "revoke" : "grant" }),
      });
      window.location.reload();
    });

    const form = document.getElementById("create-user-form") as HTMLFormElement;
    const errorEl = document.getElementById("create-error") as HTMLElement;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const res = await fetch("/api/admin/users", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          name: data.get("name"),
          email: data.get("email"),
          password: data.get("password"),
        }),
      });
      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        errorEl.textContent = body.error?.message ?? body.error ?? "Could not create user.";
        errorEl.style.display = "block";
        return;
      }
      window.location.reload();
    });
  </script>
</BaseLayout>
