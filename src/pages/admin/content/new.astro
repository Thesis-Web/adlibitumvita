---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="New Entry" noindex container="wide">
  <p class="eyebrow"><a href="/admin/content">← Content</a></p>
  <h1>New Entry</h1>

  <form id="entry-form" class="entry-form">
    <div class="field">
      <label for="collection">Collection</label>
      <select id="collection" name="collection" required>
        <option value="captains-log">Captain's Log</option>
        <option value="beyond-the-map">Beyond the Map</option>
      </select>
    </div>

    <div class="field">
      <label for="title">Title</label>
      <input id="title" name="title" required />
    </div>

    <div class="field">
      <label for="slug">Slug</label>
      <input id="slug" name="slug" placeholder="auto-generated from title" />
    </div>

    <div class="field">
      <label for="subtitle">Subtitle</label>
      <input id="subtitle" name="subtitle" />
    </div>

    <div class="field">
      <label for="excerpt">Excerpt</label>
      <textarea id="excerpt" name="excerpt" rows="2"></textarea>
    </div>

    <div class="field">
      <label for="body_markdown">Body (Markdown)</label>
      <textarea id="body_markdown" name="body_markdown" rows="16" required class="body-editor"></textarea>
    </div>

    <div class="field-row field-row-3">
      <div class="field">
        <label for="day_number">Day number</label>
        <input id="day_number" name="day_number" type="number" />
      </div>
      <div class="field">
        <label for="chapter_number">Chapter number</label>
        <input id="chapter_number" name="chapter_number" type="number" />
      </div>
      <div class="field">
        <label for="section_number">Section</label>
        <input id="section_number" name="section_number" />
      </div>
      <div class="field">
        <label for="expedition_date">Expedition date</label>
        <input id="expedition_date" name="expedition_date" type="date" />
      </div>
      <div class="field">
        <label for="location">Location</label>
        <input id="location" name="location" />
      </div>
      <div class="field">
        <label for="tags">Tags (comma separated)</label>
        <input id="tags" name="tags" />
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="visibility">Visibility</label>
        <select id="visibility" name="visibility">
          <option value="members">Members</option>
          <option value="public">Public</option>
        </select>
      </div>
      <div class="field">
        <label for="sort_order">Sort order</label>
        <input id="sort_order" name="sort_order" type="number" step="any" />
      </div>
    </div>

    <p id="form-error" class="form-error" style="display: none;"></p>

    <div class="form-actions">
      <button class="btn secondary" type="submit" data-status="draft">Save Draft</button>
      <button class="btn coral" type="submit" data-status="published">Publish</button>
    </div>
  </form>

  <style>
    .entry-form { max-width: 44rem; }
    .field-row-3 { grid-template-columns: repeat(3, 1fr); }
    @media (max-width: 40rem) { .field-row-3 { grid-template-columns: 1fr 1fr; } }
    .body-editor { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.92rem; line-height: 1.55; }
    .form-error { color: #b8442c; font-size: 0.88rem; }
    .form-actions { display: flex; gap: 0.75rem; margin-top: 0.5rem; }
  </style>

  <script>
    const form = document.getElementById("entry-form") as HTMLFormElement;
    const titleInput = document.getElementById("title") as HTMLInputElement;
    const slugInput = document.getElementById("slug") as HTMLInputElement;
    const errorEl = document.getElementById("form-error") as HTMLElement;
    let slugTouched = false;

    slugInput.addEventListener("input", () => { slugTouched = true; });
    titleInput.addEventListener("input", () => {
      if (slugTouched) return;
      slugInput.value = titleInput.value
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
    });

    let submittedStatus = "draft";
    form.querySelectorAll("button[type=submit]").forEach((btn) => {
      btn.addEventListener("click", () => {
        submittedStatus = (btn as HTMLElement).dataset.status ?? "draft";
      });
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorEl.style.display = "none";
      const data = new FormData(form);

      const payload = {
        collection: data.get("collection"),
        title: data.get("title"),
        slug: (data.get("slug") as string) || undefined,
        subtitle: (data.get("subtitle") as string) || null,
        excerpt: (data.get("excerpt") as string) || null,
        body_markdown: data.get("body_markdown"),
        day_number: data.get("day_number") ? Number(data.get("day_number")) : null,
        chapter_number: data.get("chapter_number") ? Number(data.get("chapter_number")) : null,
        section_number: (data.get("section_number") as string) || null,
        expedition_date: (data.get("expedition_date") as string) || null,
        location: (data.get("location") as string) || null,
        tags: (data.get("tags") as string)
          ? (data.get("tags") as string).split(",").map((t) => t.trim()).filter(Boolean)
          : [],
        visibility: data.get("visibility"),
        sort_order: data.get("sort_order") ? Number(data.get("sort_order")) : null,
        status: submittedStatus,
      };

      const res = await fetch("/api/admin/content", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        errorEl.textContent = "Could not save entry. Check required fields.";
        errorEl.style.display = "block";
        return;
      }

      const entry = await res.json();
      window.location.href = `/admin/content/${entry.id}`;
    });
  </script>
</BaseLayout>
