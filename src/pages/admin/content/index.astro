---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { listContentEntries, type Collection, type ContentStatus } from "../../../lib/content.js";

const collectionFilter = Astro.url.searchParams.get("collection") as Collection | null;
const statusFilter = Astro.url.searchParams.get("status") as ContentStatus | null;

const entries = listContentEntries({
  collection: collectionFilter ?? undefined,
  status: statusFilter ?? undefined,
});
---

<BaseLayout title="Manage Content" noindex container="wide">
  <p class="eyebrow"><a href="/admin">← Admin</a></p>
  <h1>Content</h1>

  <form method="get" class="filter-row">
    <select name="collection" aria-label="Filter by collection">
      <option value="" selected={!collectionFilter}>All collections</option>
      <option value="captains-log" selected={collectionFilter === "captains-log"}>Captain's Log</option>
      <option value="beyond-the-map" selected={collectionFilter === "beyond-the-map"}>Beyond the Map</option>
    </select>
    <select name="status" aria-label="Filter by status">
      <option value="" selected={!statusFilter}>All statuses</option>
      <option value="draft" selected={statusFilter === "draft"}>Draft</option>
      <option value="published" selected={statusFilter === "published"}>Published</option>
    </select>
    <button class="btn secondary" type="submit">Filter</button>
    <a class="btn coral filter-new" href="/admin/content/new">New Entry</a>
  </form>

  {entries.length === 0 ? (
    <p class="empty-note">No entries match.</p>
  ) : (
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Collection</th>
            <th>Label</th>
            <th>Status</th>
            <th>Visibility</th>
            <th>Updated</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {entries.map((entry) => (
            <tr>
              <td><strong>{entry.title}</strong></td>
              <td>{entry.collection === "captains-log" ? "Captain's Log" : "Beyond the Map"}</td>
              <td class="muted">
                {entry.day_number != null && `Day ${entry.day_number}`}
                {entry.chapter_number != null && `Ch. ${entry.chapter_number}`}
              </td>
              <td><span class={`badge ${entry.status}`}>{entry.status}</span></td>
              <td><span class={`badge ${entry.visibility}`}>{entry.visibility}</span></td>
              <td class="muted">{entry.updated_at.slice(0, 10)}</td>
              <td class="row-actions">
                <a href={`/admin/content/${entry.id}`}>Edit</a>
                {entry.status === "published" && (
                  <>
                    {" · "}
                    <a href={`/library/${entry.collection}/${entry.slug}`} target="_blank">View</a>
                  </>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <style>
    .filter-row { display: flex; gap: 0.75rem; margin: 1.5rem 0 2rem; flex-wrap: wrap; align-items: center; }
    .filter-row select { width: auto; min-width: 10rem; }
    .filter-new { margin-left: auto; }
    .empty-note {
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      padding: 2rem;
      color: var(--muted);
      text-align: center;
    }
    .row-actions { white-space: nowrap; font-size: 0.9rem; }
  </style>
</BaseLayout>
