---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listContentEntries } from "../../lib/content.js";

const all = listContentEntries();
const drafts = all.filter((e) => e.status === "draft").length;
const published = all.filter((e) => e.status === "published").length;
---

<BaseLayout title="Admin" noindex>
  <h1>Admin</h1>
  <div style="display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); margin-bottom: 2rem;">
    <div class="card"><strong style="font-size: 1.5rem;">{all.length}</strong><p class="muted">total entries</p></div>
    <div class="card"><strong style="font-size: 1.5rem;">{drafts}</strong><p class="muted">drafts</p></div>
    <div class="card"><strong style="font-size: 1.5rem;">{published}</strong><p class="muted">published</p></div>
  </div>

  <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
    <a class="btn" href="/admin/content/new">New Entry</a>
    <a class="btn secondary" href="/admin/content">Manage Content</a>
    <a class="btn secondary" href="/admin/users">Manage Users</a>
  </div>
</BaseLayout>
