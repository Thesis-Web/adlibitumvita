# Ad Libitum Vita — environment configuration.
# Copy to .env for local development. Production values live only in
# /srv/adlibitumvita/shared/.env on the server — never commit real values.

NODE_ENV=development

# SQLite database file. Production: /srv/adlibitumvita/shared/data/adlibitumvita.sqlite3
DATABASE_PATH=.data/dev.sqlite3

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3211

# Media storage: "local" works out of the box; switch to "r2" once credentials exist.
MEDIA_DRIVER=local
MEDIA_LOCAL_PATH=.data/media

# Cloudflare R2 (only required when MEDIA_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only set if the bucket/domain is intended to serve public assets directly.
R2_PUBLIC_BASE_URL=

# Loopback-only port the Node service binds to. nginx proxies to this.
PORT=3211
